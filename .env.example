# Copy to .env and fill in. EXPO_PUBLIC_ vars are inlined at build time —
# restart the bundler with `npx expo start -c` after changing them.

# Clerk (Dashboard -> Configure -> API Keys -> Publishable key)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Supabase (used only as the database, NOT for auth)
# Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
